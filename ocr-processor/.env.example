# Environment variables for ocr-processor
# Copy to .env and fill in real values — never commit .env to source control

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ocrprocessor
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Security — must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-key

# LLM — OpenAI API key (or your chosen provider)
LLM_API_KEY=sk-...
